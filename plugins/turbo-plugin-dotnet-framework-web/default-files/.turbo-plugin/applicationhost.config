<?xml version="1.0" encoding="UTF-8"?>
<!--
  turbo-plugin 共享 applicationhost.config source-of-truth template.

  這是「範本」，不是使用者的設定檔。第一次 tp-run(或 New-ApphostConfig)發現
  .turbo-plugin/applicationhost.config 不存在時，就以此為骨架產生那個檔。
  執行期不改動使用者的那份檔:tp-run 每次啟動另外渲染一份暫存設定檔，
  把 physicalPath 換成當前 worktree、站台改名為帶 identity hash 的執行期名稱。

  Site name 命名規則: 就是「專案名」(csproj 檔名去副檔名),與 Visual Studio 寫的一致。
  帶 project identity hash 的名字(<csproj-stem>-<sha256前8字元>)是「執行期」名稱,
  只會出現在 tp-run 每次啟動渲染的暫存設定檔與 iisexpress 命令列上 — 那個 hash 由本機
  .git 絕對路徑算出,絕不可寫進這份要進版控、跨同事共享的檔案。

  本檔案僅含 IIS Express 啟動最低需要的 <applicationPools> 與 <sites> 骨架,不含任何
  <site> 條目。實際的 site 由 New-ApphostConfig 依 csproj 的 IIS 設定產生(不需要開
  Visual Studio),或由使用者從 VS 產生的設定檔複製過來。
-->
<configuration>
  <system.applicationHost>
    <applicationPools>
      <add name="Clr4IntegratedAppPool" managedRuntimeVersion="v4.0" managedPipelineMode="Integrated" CLRConfigFile="%IIS_USER_HOME%\config\aspnet.config" autoStart="true" />
      <add name="Clr4ClassicAppPool" managedRuntimeVersion="v4.0" managedPipelineMode="Classic" CLRConfigFile="%IIS_USER_HOME%\config\aspnet.config" autoStart="true" />
      <add name="UnmanagedClassicAppPool" managedRuntimeVersion="" managedPipelineMode="Classic" autoStart="true" />
      <add name="DefaultAppPool" autoStart="true" />
      <applicationPoolDefaults managedRuntimeLoader="v4.0">
        <processModel />
      </applicationPoolDefaults>
    </applicationPools>
    <sites>
      <!--
        <site> 條目由 New-ApphostConfig 依 csproj 產生,或從 Visual Studio 的設定檔複製。
        兩者寫出來的 site name 都是「專案名」,tp-run 就是照這個名字找站台。
      -->
      <siteDefaults>
        <logFile logFormat="W3C" directory="%IIS_USER_HOME%\Logs" />
        <traceFailedRequestsLogging directory="%IIS_USER_HOME%\TraceLogFiles" enabled="true" maxLogFileSizeKB="1024" />
      </siteDefaults>
      <applicationDefaults applicationPool="Clr4IntegratedAppPool" />
      <virtualDirectoryDefaults allowSubDirConfig="true" />
    </sites>
  </system.applicationHost>
</configuration>
