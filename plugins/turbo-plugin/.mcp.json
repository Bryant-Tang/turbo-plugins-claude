{
    "mcpServers": {
        "tp-dbhub": {
            "type": "stdio",
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "--init",
                "-v",
                "${CLAUDE_PROJECT_DIR}/.turbo-plugin/dbhub.local.toml:/dbhub.toml",
                "bytebase/dbhub:latest",
                "--transport",
                "stdio",
                "--config",
                "/dbhub.toml"
            ],
            "env": {}
        }
    }
}
