# SVN dump files are mixed text+binary content (PROPS-END markers + raw file bytes).
# Git's autocrlf must NOT mangle them — declare as binary so working-tree always
# matches what svnadmin produced. Without this, autocrlf=true on Windows converts
# LF→CRLF and svnadmin load fails with "Could not convert ' 2' into a number".
plugins/*/tests/fixtures/seed/*.dump binary

# Cross-plugin shared single-source files (checked by tools/verify-core-identical):
# pin LF so the byte-identical guarantee is stable regardless of core.autocrlf or
# the checkout platform. These files are copied verbatim into multiple plugins and
# must stay byte-for-byte equal; without a pinned EOL, autocrlf=true would make a
# fresh `git checkout` (CRLF) differ from a hand-copied (LF) working tree.
plugins/*/scripts/lib/Core.ps1                            text eol=lf
plugins/*/scripts/lib/core.sh                             text eol=lf
plugins/*/skills/tp-setup/assets/setup-base.md            text eol=lf
plugins/*/skills/tp-setup/assets/claudemd-base-snippet.md text eol=lf
